# --- Wajib di production ---
ADMIN_PASSWORD=          # password login tim review
AUTH_SECRET=             # string acak panjang untuk menandatangani sesi (mis. `openssl rand -hex 32`)

# --- Claude (tanpa ini app berjalan dalam mode demo) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Threads API (tanpa ini publikasi = dry-run) ---
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Instagram Graph API (akun Professional + Facebook Page; tanpa ini = dry-run) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
PUBLIC_BASE_URL=         # URL publik app ini; Instagram mengunduh gambar slide dari sini

# --- Opsional ---
TIMEZONE=Asia/Jakarta
OFFICE_INTERVAL_HOURS=6  # 0 = putaran otomatis mati
# SCHEDULER=off          # matikan scheduler bawaan (mis. jika memakai /api/cron)
# CRON_SECRET=           # aktifkan GET /api/cron dengan header Authorization: Bearer <secret>
# DATA_DIR=./data
# BRAND_NAME=Media Kita  # nama default sebelum diatur di "Brief brand"
